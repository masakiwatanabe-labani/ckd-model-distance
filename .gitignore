# ---------------------------------------------------------------------------
# Primary data. NOT redistributable: obtain it yourself, see data/README.md.
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep

# Interim matrices. These are effectively the primary data in another
# container (per-sample expression / abundance matrices), so they must not
# be published either. Regenerated by src/01_load.py and src/00b_fetch_external.py.
data/interim/*
!data/interim/.gitkeep

# Reference tables downloaded from Ensembl BioMart, UniProt and MSigDB.
# Excluded because the MSigDB KEGG collection carries redistribution
# restrictions that the other collections do not. Regenerated in a few
# minutes by src/00_fetch_refs.py.
data/ref/*
!data/ref/.gitkeep

# Run logs contain absolute paths (and therefore the local user name).
logs/*
!logs/.gitkeep

# Manuscript text is kept out of the public repository. The manuscript of record is
# the docx; keeping a Markdown copy here as well produced version drift once already.
/manuscript/
projection/manuscript/
# C draft of the same manuscript; kept out for the same reason.
projection/manuscript_C/*

# Local project instructions, not part of the published analysis.
CLAUDE.md

# Environments and OS cruft
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
._*
.Trashes
Thumbs.db

# Editor / tooling
.vscode/
.idea/
*.swp

# Gene set collections are downloaded, not redistributed. MSigDB's KEGG collection
# carries redistribution restrictions, and the Enrichr-hosted Reactome library is a
# redistribution whose terms are not stated; data/ref/ is excluded wholesale above and
# src/00_fetch_refs.py regenerates all four collections.
projection/**/*.gmt

# Caches and OS cruft inside the projection tree
projection/**/__pycache__/
projection/**/.DS_Store

# ---------------------------------------------------------------------------
# Round 9 (release). Three further exclusions, decided when the repository was
# made public alongside the submitted manuscript.
# ---------------------------------------------------------------------------

# The Pod-TRECK proteome is author-held data from a parallel study that is
# accepted but not yet published (Ito et al., FEBS J). Its per-sample tables are
# already excluded with data/raw and data/interim above; what the manuscript
# needs in order for Group A to be checkable is the per-gene detection call, and
# that is published as projection/results/round7/groupA_detection_calls.tsv.
# The abundance tables themselves are supplied on request, not here.

# A separate, unfinished analysis of a feline urine proteome, which quotes
# unpublished values from the same accepted study. Not part of this manuscript.
results/urine_proteome/
src/29_urine_proteome.py
src/30_febs_signature_urine.py
src/31_urine_reannotation.py
PHASE2_PLAN.md

# Internal handover notes: they name a local machine and refer to files that are
# deliberately outside the repository.
HANDOVER.md

# Run logs under the analysis tree carry absolute paths, like logs/ above.
projection/**/*.log

# The paragraph-order manifest is derived from the manuscript text, which this
# repository deliberately does not carry.
projection/extracted/

# Per-protein fold changes from the Pod-TRECK proteome. Detection calls are
# published (they are what Group A rests on); abundance and fold-change values
# from that unpublished dataset are not. protein_decomp.py regenerates this file
# from the proteome tables once they are obtained.
projection/results/protein/delta_matrix_protein.tsv

# ---------------------------------------------------------------------------
# Revision 1. What the revision adds, and what stays out of the repository.
# ---------------------------------------------------------------------------

# Peer review is confidential. The reviewers' comments, the submitted documents
# they refer to, and the scripts that read them are not published.
projection/data/base/
projection/code/revision1/ao_check_quotes.py
projection/code/revision1/ao_extract_comments.py

# The response letter and the cover letter, and the scripts that hold their text.
# (The manuscript sources themselves are already excluded with manuscript_C above.)
projection/code/revision1/build_response_letter.py
projection/code/revision1/build_cover_letter.py
projection/code/revision1/build_letters_docx.py

# Working directory of the tracked-changes and blue builds. base.xml / rev.xml /
# tracked.xml / blue.xml are the manuscript body in OOXML, i.e. the manuscript text.
projection/results/roundR/tracked_build/

# The plotting data behind the supplementary figures is published; the manuscript
# sources and the rendered figures in the same tree are not.
!projection/manuscript_C/figure_data/

# Third-party primary files are named with their origin and checksum in
# data/README.md and fetched by src/00b_fetch_external.py; the files themselves
# (Li et al. MOESM3, GSE98622) stay under data/raw and data/external, excluded above.

# Scripts whose content is the manuscript text itself. The revision was applied by
# editing scripts that carry the old and the new wording verbatim; publishing them
# would publish the manuscript body piecemeal, which this repository does not do.
# (The ones already published from the submitted round carry almost no prose and
# stay published; git ignores only untracked files.)
projection/code/revision1/apply_*.py

# Derived files that are the manuscript text in another container.
projection/results/roundR/an_block_map.tsv
projection/results/roundR/an_format_lost.tsv
projection/results/roundR/limitations_paragraph.txt
projection/results/roundR/supp_labels.tsv
projection/results/roundR/supplementary_number_map.tsv
projection/results/roundR/response_letter_todo.tsv

# Terms searched for when checking that no third party's name reaches a submitted
# file. The list names people outside the author group, so it stays local.
projection/leak_terms.txt

# Mapping from the contract analysis's own file name to the published
# Supplementary Data S1. The source file name carries the provider's job number.
projection/results/roundR/local/

# Tools that assemble, align and check the manuscript docx. They cannot run without
# the manuscript sources, which this repository does not carry, and they name the
# publisher's paragraph styles. Same treatment as apply_*.py above.
projection/code/revision1/an_*.py
